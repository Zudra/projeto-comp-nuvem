# .env.example
#
# Modelo das variáveis de ambiente do projeto, com valores FICTÍCIOS.
# O docker-compose.yml usa este arquivo como padrão. Para usar valores
# próprios, copie para .env e altere lá (o .env não vai para o Git):
#
#   cp .env.example .env

# ---- Banco de dados: lidas pelo container oficial do PostgreSQL ----
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca_app
POSTGRES_PASSWORD=troque-esta-senha

# ---- Conexão da API com o banco: lidas em backend/src/database.js ----
# DB_HOST é o NOME DO SERVIÇO do banco no docker-compose.yml, não um IP.
# DB_NAME, DB_USER e DB_PASSWORD precisam ser iguais aos de cima.
DB_HOST=db
DB_PORT=5432
DB_NAME=biblioteca
DB_USER=biblioteca_app
DB_PASSWORD=troque-esta-senha

# ---- API ----
PORT=3000
